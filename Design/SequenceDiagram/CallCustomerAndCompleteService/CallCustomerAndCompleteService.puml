@startuml
skinparam style strictuml

actor Staff
boundary "Queue Management Page" as QueueUI
control "Queue Controller" as QueueController
entity "Appointment" as AppointmentEntity
entity "Queue" as QueueEntity

Staff -> QueueUI : callNextCustomer(serviceID)

QueueUI -> QueueController : requestNextCustomer(serviceID)

QueueController -> AppointmentEntity : getNextAppointment(serviceID)

QueueController -> AppointmentEntity : updateStatus(appointmentID, "In Service")

QueueController -> AppointmentEntity : updateStatus(appointmentID, "Completed")

QueueController -> QueueEntity : getNextQueueCustomer(serviceID)

QueueController -> QueueEntity : updateQueueOrder(queueID)


QueueController -> QueueUI : displayCustomerDetails(customerID, queueNumber)

@enduml